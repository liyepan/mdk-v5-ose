<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- 整体走浅色 + 细边框，和 uVision / VS Code Light+ 一个味道 -->

  <Style Selector="Window">
    <Setter Property="FontFamily" Value="Inter, Microsoft YaHei, WenQuanYi Micro Hei, Noto Sans CJK SC, sans-serif" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <!-- 菜单栏 -->
  <Style Selector="Menu.mainmenu">
    <Setter Property="Background" Value="#F5F6F8" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="Menu.mainmenu > MenuItem">
    <Setter Property="Padding" Value="9,5,9,5" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <!-- 工具栏 -->
  <Style Selector="Border.toolbar">
    <Setter Property="Background" Value="#F0F1F4" />
    <Setter Property="BorderBrush" Value="#DDE0E5" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="6,4" />
  </Style>

  <Style Selector="Button.tool">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="9,3" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="#22262B" />
    <Setter Property="MinHeight" Value="24" />
  </Style>
  <Style Selector="Button.tool:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#DCE4F2" />
    <Setter Property="BorderBrush" Value="#B9C9E6" />
  </Style>
  <Style Selector="Button.tool:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="#C7D6EE" />
    <Setter Property="BorderBrush" Value="#9FB6DC" />
  </Style>
  <Style Selector="Button.tool.accent">
    <Setter Property="Foreground" Value="#1554B0" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Border.sep">
    <Setter Property="Width" Value="1" />
    <Setter Property="Margin" Value="6,3" />
    <Setter Property="Background" Value="#D8DCE2" />
  </Style>

  <!-- 状态栏 -->
  <Style Selector="Border.statusbar">
    <Setter Property="Background" Value="#EFF1F4" />
    <Setter Property="BorderBrush" Value="#DDE0E5" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="8,3" />
  </Style>

  <!-- 面板 -->
  <Style Selector="Border.pane">
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="BorderBrush" Value="#E3E6EA" />
    <Setter Property="BorderThickness" Value="0,0,1,1" />
  </Style>

  <Style Selector="TreeViewItem">
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="Padding" Value="2,1" />
  </Style>

  <!-- 标签页 -->
  <Style Selector="TabControl.editors /template/ ItemsPresenter">
    <Setter Property="Margin" Value="0" />
  </Style>
  <Style Selector="TabControl.editors TabItem">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="MinHeight" Value="24" />
  </Style>
  <Style Selector="TabControl.output TabItem">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Padding" Value="10,2" />
    <Setter Property="MinHeight" Value="22" />
  </Style>

</Styles>
