<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="using:UvisionOse.Core"
        x:Class="UvisionOse.MainWindow"
        Title="uVision5-OSE"
        Width="1240" Height="800"
        MinWidth="900" MinHeight="600"
        FontFamily="Inter, Microsoft YaHei, WenQuanYi Micro Hei, Noto Sans CJK SC, sans-serif"
        FontSize="12"
        Background="#F3F4F6">

  <Panel>
    <DockPanel x:Name="ContentRoot">
      <Menu DockPanel.Dock="Top" Classes="mainmenu">
        <MenuItem Header="文件(_F)">
          <MenuItem Header="新建文件" Click="OnNewFileClick" />
          <MenuItem Header="打开工程..." Click="OnOpenProjectClick" />
          <MenuItem x:Name="RecentMenu" Header="最近打开的工程" />
          <Separator />
          <MenuItem Header="保存" Click="OnSaveClick" />
          <Separator />
          <MenuItem Header="关闭工程" Click="OnCloseProjectClick" />
          <MenuItem Header="退出" Click="OnExitClick" />
        </MenuItem>
        <MenuItem Header="编辑(_E)">
          <MenuItem Header="撤销" IsEnabled="False" />
          <MenuItem Header="重做" IsEnabled="False" />
        </MenuItem>
        <MenuItem Header="视图(_V)">
          <MenuItem Header="工程窗口" Click="OnToggleProjectDock" />
          <MenuItem Header="输出窗口" Click="OnToggleOutputDock" />
        </MenuItem>
        <MenuItem Header="工程(_P)">
          <MenuItem Header="编译 F7" Click="OnBuildClick" />
          <MenuItem Header="重新编译" Click="OnRebuildClick" />
          <MenuItem Header="清理" Click="OnCleanClick" />
          <MenuItem Header="停止编译" Click="OnStopClick" />
          <Separator />
          <MenuItem Header="Options for Target..." IsEnabled="False" />
        </MenuItem>
        <MenuItem Header="烧写(_L)">
          <MenuItem Header="下载到 Flash" IsEnabled="False" />
        </MenuItem>
        <MenuItem Header="调试(_D)">
          <MenuItem Header="启动调试" IsEnabled="False" />
        </MenuItem>
        <MenuItem Header="工具(_T)">
          <MenuItem Header="配置编译器..." Click="OnConfigureToolchainClick" />
        </MenuItem>
        <MenuItem Header="帮助(_H)">
          <MenuItem Header="关于" Click="OnAboutClick" />
        </MenuItem>
      </Menu>

      <Border DockPanel.Dock="Top" Classes="toolbar">
        <StackPanel Orientation="Horizontal" Spacing="2">
          <Button Classes="tool" Content="新建" Click="OnNewFileClick" />
          <Button Classes="tool" Content="打开" Click="OnOpenProjectClick" />
          <Button Classes="tool" Content="保存" Click="OnSaveClick" />
          <Border Classes="sep" />
          <Button x:Name="BuildButton" Classes="tool accent" Content="编译" Click="OnBuildClick" />
          <Button x:Name="RebuildButton" Classes="tool" Content="重新编译" Click="OnRebuildClick" />
          <Button x:Name="CleanButton" Classes="tool" Content="清理" Click="OnCleanClick" />
          <Button x:Name="StopButton" Classes="tool" Content="停止" Click="OnStopClick" IsEnabled="False" />
          <Border Classes="sep" />
          <Button Classes="tool" Content="下载" IsEnabled="False" />
          <Border Classes="sep" />
          <TextBlock Text="Target:" VerticalAlignment="Center" Margin="8,0,4,0" Foreground="#5B6270" />
          <ComboBox x:Name="TargetCombo" Width="120" Height="22" SelectionChanged="OnTargetComboChanged" />
          <TextBlock Text="符号:" VerticalAlignment="Center" Margin="8,0,4,0" Foreground="#5B6270" />
          <ComboBox x:Name="SymbolCombo" Width="170" Height="22" IsEditable="True" />
        </StackPanel>
      </Border>

      <Border DockPanel.Dock="Bottom" Classes="statusbar">
        <Grid ColumnDefinitions="*,Auto,Auto,Auto">
          <TextBlock x:Name="StatusMessage" Grid.Column="0" Text="就绪" VerticalAlignment="Center" />
          <TextBlock x:Name="StatusSize" Grid.Column="1" Margin="12,0" Foreground="#5B6270" VerticalAlignment="Center" />
          <TextBlock x:Name="StatusToolchain" Grid.Column="2" Margin="12,0" Foreground="#5B6270" VerticalAlignment="Center" />
          <TextBlock x:Name="StatusPosition" Grid.Column="3" Foreground="#5B6270" VerticalAlignment="Center" />
        </Grid>
      </Border>

      <Grid ColumnDefinitions="270,4,*">
        <Border Grid.Column="0" Classes="pane">
          <TreeView x:Name="ProjectTree" Background="Transparent" SelectionChanged="OnTreeSelectionChanged" />
        </Border>
        <GridSplitter Grid.Column="1" Background="#E1E4E8" ResizeDirection="Columns" />
        <Grid Grid.Column="2" RowDefinitions="*,4,200">
          <TabControl x:Name="EditorTabs" Grid.Row="0" Classes="editors" />
          <GridSplitter Grid.Row="1" Background="#E1E4E8" ResizeDirection="Rows" />
          <TabControl x:Name="OutputTabs" Grid.Row="2" Classes="output">
            <TabItem Header="Build Output">
              <TextBox x:Name="BuildOutputText" AcceptsReturn="True" IsReadOnly="True"
                       FontFamily="Consolas, DejaVu Sans Mono, monospace" FontSize="11"
                       BorderThickness="0" Background="Transparent" TextWrapping="NoWrap" />
            </TabItem>
            <TabItem Header="Error List">
              <ListBox x:Name="ErrorList" Background="Transparent" BorderThickness="0"
                       FontSize="11" DoubleTapped="OnErrorListDoubleTapped">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="core:Diagnostic">
                    <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </TabItem>
          </TabControl>
        </Grid>
      </Grid>
    </DockPanel>

    <!-- 加载遮罩：模糊背景 + 圆角卡片 + 蓝色进度条 -->
    <Border x:Name="LoadingLayer" IsVisible="False" Background="#BFFFFFFF">
      <Border x:Name="LoadingCard" Width="460" Height="150"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              CornerRadius="12" Background="#FFFFFF" BorderBrush="#C9CED6" BorderThickness="1">
        <Border.Effect>
          <DropShadowEffect BlurRadius="28" OffsetX="0" OffsetY="6" Color="#2A0F172A" />
        </Border.Effect>
        <StackPanel Margin="26,26,26,22" Spacing="6">
          <TextBlock x:Name="LoadingTitle" Text="加载中…" FontSize="15" FontWeight="SemiBold" Foreground="#1F2328" />
          <TextBlock x:Name="LoadingDetail" Text="正在读取工程文件…" FontSize="11" Foreground="#6B7280" />
          <Border x:Name="LoadingBarTrack" Height="8" CornerRadius="4" Background="#E3E7EC" Margin="0,22,0,0" ClipToBounds="True">
            <Border x:Name="LoadingBarFill" HorizontalAlignment="Left" Width="140" CornerRadius="4">
              <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                  <GradientStop Color="#2F7FE8" Offset="0" />
                  <GradientStop Color="#63A6F7" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
            </Border>
          </Border>
        </StackPanel>
      </Border>
    </Border>
  </Panel>
</Window>
